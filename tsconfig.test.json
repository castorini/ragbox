{
  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "types": [
      "node",
      "vite/client",
      "@webgpu/types"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}

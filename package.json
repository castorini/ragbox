{
  "name": "duckdb-opfs-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "prepare:nfcorpus": "node --import tsx scripts/prepare-nfcorpus.ts"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@huggingface/transformers": "4.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@webgpu/types": "^0.1.74",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "4.1.11"
  }
}

    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "4.1.11"
